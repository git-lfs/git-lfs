#!/bin/sh -e

# Stores the signing credentials provided in the
# DEVELOPER_ID_* environment variables into a dedicated keychain.

. "$(dirname "$0")/../lib/macos_keychain.sh"

if [ -z "$CI" ]; then
  echo "This script should only be run in a CI environment." >&2
  exit 1
fi

check_var_exists "DEVELOPER_ID_CERT"
check_var_exists "DEVELOPER_ID_PASSWORD"

password="$(head -c 40 /dev/urandom | base64)"

echo "Creating '$KEYCHAIN_ID' keychain ..."
security create-keychain -p "$password" "$KEYCHAIN_ID"
security "set-keychain-settings" -u "$KEYCHAIN_ID"
security unlock-keychain -p "$password" "$KEYCHAIN_ID"

echo "Setting '$KEYCHAIN_ID' keychain as default ..."
security default-keychain -s "$KEYCHAIN_ID"

tmp_dir="$(mktemp -d "$HOME/$(basename "$0").XXXXXXXX")"
cert_file="$tmp_dir/developer_id_cert.p12"

set +e
(
  set -e

  echo "Writing Developer ID certificate to PKCS#12 file ..."
  echo "$DEVELOPER_ID_CERT" | base64 --decode >"$cert_file"

  printf 'Wrote %d bytes (SHA-256 %s) to certificate file\n' \
    "$(wc -c <"$cert_file")" "$(shasum -ba 256 "$cert_file" | cut -d' ' -f1)"

  echo "Storing Developer ID certificate in keychain ..."
  security import "$cert_file" -f pkcs12 -P "$DEVELOPER_ID_PASSWORD" \
    -k "$KEYCHAIN_ID" -A

  echo "Setting '$KEYCHAIN_ID' keychain permissions ..."
  security "set-key-partition-list" -S "apple-tool:,apple:,codesign:" \
    -s -k "$password" "$KEYCHAIN_ID" >/dev/null
)
status="$?"
set -e

echo "Cleaning up certificate file ..."
rm -rf "$tmp_dir" || true

exit "$status"
